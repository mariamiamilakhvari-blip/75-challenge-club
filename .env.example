NEXTAUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
NEXTAUTH_SECRET=your-secret-here
MONGO_URI=mongodb://localhost:27017/nextjs-starter

# Google OAuth — https://console.developers.google.com
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=openrouter/free

# Dodo Payments — test_mode | live_mode
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PAYMENTS_API_KEY=
# Webhook signing secret from Dodo dashboard → Developer → Webhooks (whsec_...)
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_MONTHLY_PRODUCT_ID=
DODO_YEARLY_PRODUCT_ID=
# Base URL Dodo returns users to after checkout (defaults to NEXTAUTH_URL)
APP_URL=
